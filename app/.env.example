# Copy to .env and fill in. .env is gitignored.
DEBUG=True
SECRET_KEY=generate-your-own
DATABASE_URL=postgres://sai:devpassword@127.0.0.1:5434/student_ai

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Nightly refresh (manage.py scheduler): local time, HH:MM.
NIGHTLY_AT=02:00

# Backups (manage.py backup_db). Default: <home>/student_ai_backups.
# Keep a copy OFF this machine; the dumps are not encrypted.
# BACKUP_DIR=
# Used when pg_dump is not on PATH: the backup runs inside this container.
DB_CONTAINER=student_ai_db

# Behind a reverse proxy, the number of proxies whose X-Forwarded-For is trusted.
NUM_PROXIES=0
